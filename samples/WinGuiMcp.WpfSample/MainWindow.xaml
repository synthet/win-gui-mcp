<Window x:Class="WinGuiMcp.WpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinGuiMcp WPF Sample" Height="300" Width="500">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Dialog..." Click="OpenDialog_Click" AutomationProperties.AutomationId="menuOpenDialog" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
    </Menu>
    <StackPanel Margin="16">
      <TextBlock x:Name="StatusText" Text="Use File → Open Dialog..." />
    </StackPanel>
  </DockPanel>
</Window>
